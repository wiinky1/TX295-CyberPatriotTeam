jQuery(document).ready(function() {

	jQuery(document).on('click', 'tr.mentor-main', function() {
		mentor_id = jQuery(this).data('id')
		showclass = 'tr.mentor-about-' + mentor_id;
		jQuery('tr.mentor-about').hide();
		jQuery( showclass ).show();
	});

	jQuery(document).on('click', 'tr.org-main', function() {
		org_id = jQuery(this).data('id')
		showclass = 'tr.org-id-' + org_id;
		jQuery('tr.coach-main').hide();
		jQuery('tr.team-main').hide();
		jQuery('tr.team-about').hide();
		jQuery( showclass ).show();
	});

	jQuery(document).on('click', 'tr.coach-main', function() {
		coach_id = jQuery(this).data('id')
		org_id = jQuery(this).data('org')
		showclass = 'tr.org-' + org_id + '-coach-id-' + coach_id;
		jQuery('tr.team-about').hide();
		jQuery('tr.team-main').hide();
		jQuery( showclass ).show();
	});

	jQuery(document).on('click', 'tr.team-main', function() {
		coach_id = jQuery(this).data('id')
		showclass = 'tr.team-id-' + coach_id;
		jQuery('tr.team-about').hide();
		jQuery( showclass ).show();
	});

	jQuery('#ajax-response div.close-button').on('click', function(){
		jQuery('#ajax-rsponse').hide();
		location.reload();
	});

	jQuery('#cp-portal-login').on('submit', function(e){
		e.preventDefault();
		jQuery('#ajax-response-inline div.message').html('');

		const email = jQuery('#email').val().trim();
		const password = jQuery('#password').val().trim();

		jQuery.ajax({
			url: cyberpatriot.ajax_url,
			type: 'POST',
			data: {
				action: 'cyberpatriot_login',
				email: email,
				password: password,
				nonce: cyberpatriot.nonce,
			},
			success: function(response) {
				if ( response.success ) {
					location.reload();
				} else {
					console.log( response );
					jQuery('#ajax-response-inline div.message').html(response.message);
					jQuery('#ajax-response-inline').removeClass('ajax-success');
					jQuery('#ajax-response-inline').addClass('ajax-failure');
					jQuery('#ajax-response-inline').show();
					console.error("AJAX Error:", response);
				}
			},
			error: function(xhr,status,error) {
				jQuery('#ajax-response-inline div.message').html("There has been an error processing your sign in form.");
				jQuery('#ajax-response-inline').removeClass('ajax-success');
				jQuery('#ajax-response-inline').addClass('ajax-failure');
				jQuery('#ajax-response-inline').show();
				console.error("AJAX Error:", status.error);
			}
		});

	});

	jQuery('#cp-lost-password').on('submit', function(e){
		e.preventDefault();
		jQuery('#ajax-response-inline div.message').html('');

		const email = jQuery('#lost-password-email').val().trim();

		jQuery.ajax({
			url: cyberpatriot.ajax_url,
			type: 'POST',
			data: {
				action: 'cyberpatriot_lost_password',
				email: email,
				nonce: cyberpatriot.nonce,
			},
			success: function(response) {
				if ( response.success ) {
					location.reload();
				} else {
					console.log( response );
					jQuery('#ajax-response-inline div.message').html(response.message);
					jQuery('#ajax-response-inline').removeClass('ajax-success');
					jQuery('#ajax-response-inline').addClass('ajax-failure');
					jQuery('#ajax-response-inline').show();
					console.error("AJAX Error:", response);
				}
			},
			error: function(xhr,status,error) {
				jQuery('#ajax-response-inline div.message').html("There has been an error processing your password reset form.");
				jQuery('#ajax-response-inline').removeClass('ajax-success');
				jQuery('#ajax-response-inline').addClass('ajax-failure');
				jQuery('#ajax-response-inline').show();
				console.error("AJAX Error:", status.error);
			}
		});

	});

	jQuery('#cp-reset-password').on('submit', function(e){
		e.preventDefault();
		jQuery('#ajax-response-inline div.message').html('');

		const request_id = jQuery('#request_id').val().trim();
		const token_string = jQuery('#token_string').val().trim();
		const new_password = jQuery('#new_password').val().trim();
		const confirm_password = jQuery('#confirm_password').val().trim();

		if ( new_password != confirm_password ) {

			jQuery('#ajax-response-inline div.message').html("The password values must match exactly. Please review your entries and resubmit the form.");
			jQuery('#ajax-response-inline').removeClass('ajax-success');
			jQuery('#ajax-response-inline').addClass('ajax-failure');
			jQuery('#ajax-response-inline').show();

		} else {

			jQuery.ajax({
				url: cyberpatriot.ajax_url,
				type: 'POST',
				data: {
					action: 'cyberpatriot_reset_password',
					request_id: request_id,
					token_string: token_string,
					new_password: new_password,
					nonce: cyberpatriot.nonce,
				},
				success: function(response) {
					console.log( response );
					jQuery('#ajax-response-inline div.message').html(response.message);
					jQuery('#ajax-response-inline').removeClass('ajax-success');
					jQuery('#ajax-response-inline').addClass('ajax-failure');
					jQuery('#ajax-response-inline').show();
					console.error("AJAX Error:", response);
				},
				error: function(xhr,status,error) {
					jQuery('#ajax-response-inline div.message').html("There has been an error processing your password reset form.");
					jQuery('#ajax-response-inline').removeClass('ajax-success');
					jQuery('#ajax-response-inline').addClass('ajax-failure');
					jQuery('#ajax-response-inline').show();
					console.error("AJAX Error:", status.error);
				}
			});

		}

	});

	jQuery('#cp-edit-form').on('submit', function(e){
		e.preventDefault();
		jQuery('#ajax-response').text('');

		let pw = jQuery('input[name=password]').val();
		let pw2 = jQuery('input[name=password_confirm]').val();
		if(pw && pw !== pw2){
			jQuery('#ajax-response').css('color','red').text('Passwords do not match.');
			return;
		}

		let data = {
			action: 'cyberpatriot_edit',
			first_name: jQuery('input[name=first_name]').val(),
			last_name: jQuery('input[name=last_name]').val(),
			email: jQuery('input[name=email]').val(),
			t_shirt: jQuery('select[name=t_shirt]').val(),
			password: pw,
			password_confirm: pw2,
			nonce: cyberpatriot.nonce,
		};

		jQuery.post(cyberpatriot.ajax_url, data, function(resp){
			if(resp.success){
				jQuery('#ajax-response').css('color','green').text(resp.data);
				// Optionally clear password fields
				jQuery('input[name=password], input[name=password_confirm]').val('');
			}else{
				jQuery('#ajax-response').css('color','red').text(resp.data);
			}
		});
	});

	jQuery(document).on('input', '#verify_email', function() {
		var verify = jQuery('#verify_email').val();
		var coach = jQuery('#submitting_coach_email').val();

		verify = verify.trim().toLowerCase();
		coach = coach.trim().toLowerCase();

		if ( verify == coach ) {
			jQuery('.verify-notice').addClass('flash-notice');
			jQuery('.team-form-submit').prop('disabled', true);
		} else {
			jQuery('.verify-notice').removeClass('flash-notice');
			jQuery('.team-form-submit').prop('disabled', false);
		}
	});

	jQuery(document).on('submit', '#cp-volunteer-form', function(e) {
		e.preventDefault();

		let errors = [];

		const first = jQuery('#first_name').val().trim();
		const last = jQuery('#last_name').val().trim();
		const email = jQuery('#email').val().trim();
		const sponsor_employed = jQuery('#sponsor_employed').val().trim();
		const phone = jQuery('#phone').val().trim();
		const pw = jQuery('#password').val();
		const pwc = jQuery('#confirm_password').val();
		const found_out = jQuery('#found_out').val().trim();
		const t_shirt = jQuery('#t_shirt').val().trim();
		const media_release = jQuery('#media_release').val().trim();
		const competition_terms = jQuery('#competition_terms').val().trim();

		if (!first) errors.push("First name is required.");
		if (!last) errors.push("Last name is required.");
		if (!email.match(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)) errors.push("Valid email is required.");
		if (!phone) errors.push("Phone is required.");
		if (pw !== pwc) errors.push("Passwords do not match.");

		//console.log( pw + "|" + pwc );
		console.log( errors );
		response_target = '#ajax-response';
		response_scroll = '';

		var response_format = jQuery('#cp-volunteer-form').data('response_format');

		if ( response_format == 'inline' ) {
			response_target = '#ajax-response-inline';
			response_scroll = jQuery(window).scrollTop(0);
		}

		if (errors.length > 0) {
			jQuery(response_target).addClass('alert-failure');
			jQuery(response_target + ' div.message').html(errors.join("<br>"));
			jQuery(response_target).show();
			response_scroll;
			return;
		}

		jQuery.ajax({
			url: cyberpatriot.ajax_url,
			type: 'POST',
			data: {
				action: 'process_volunteer_form',
				nonce: cyberpatriot.nonce,
				data: jQuery(this).serialize()
			},
			success: function(response) {
				console.log( response )
				jQuery(response_target).addClass('alert-success');
				jQuery(response_target + ' div.message').html(response.message);
				jQuery(response_target).show();
				response_scroll;
				if (response.success) {
					if ( response.dest ) {
						//window.location.href = response.dest;
					} else {
						//window.location.reload()
					}
				}
			},
			error: function(xhr,status,error) {
				jQuery(response_target).addClass('alert-failure');
				jQuery(response_target + ' div.message').html("There has been an error processing your form.");
				jQuery(response_target).show();
				response_scroll
				console.error("AJAX Error:", status.error);
			}
		});
	});

