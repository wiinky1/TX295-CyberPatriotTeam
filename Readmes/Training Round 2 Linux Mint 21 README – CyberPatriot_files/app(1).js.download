	jQuery(document).on('submit', '.cp-mentor-contact-form', function(e) {
		e.preventDefault();

		const thisform = jQuery(this);
		const team_id = thisform.find('[name="team_id"]').val().trim();
		const mentor_id = thisform.find('[name="mentor_id"]').val().trim();
		const coach_id = thisform.find('[name="coach_id"]').val().trim();
		//const parent_id = thisform.find('[name="parent_id"]').val().trim();
		//const contact_type = thisform.find('[name="contact_type"]').val().trim();
		const message = thisform.find('[name="message"]').val().trim();

		let errors = [];

		if (!message) errors.push("Please enter a message.");
		if (!team_id || !mentor_id || !coach_id) errors.push("A form error has occurred.");

		if (errors.length > 0) {
			jQuery('.ajax-response-mentor-contact-form').html(errors.join("<br>")).addClass('ajax-failure');
			return;
		}

		jQuery.ajax({
			url: cyberpatriot.ajax_url,
			type: 'POST',
			data: {
				action: 'process_mentor_contact_form',
				nonce: cyberpatriot.nonce,
				data: thisform.serialize()
			},
			success: function(response) {
				jQuery('.ajax-response-mentor-contact-form').html(response.message).removeClass('ajax-failure');
				jQuery('.ajax-response-mentor-contact-form').html(response.message).addClass('ajax-success');
				if (response.success) {
					jQuery('tr.mentor-about, tr.team-about').hide();
				}
			},
			error: function(xhr,status,error) {
				jQuery('.ajax-response-mentor-contact-form').html("There has been an error processing your form.").removeClass('ajax-success');
				jQuery('.ajax-response-mentor-contact-form').html("There has been an error processing your form.").addClass('ajax-failure');
				console.error("AJAX Error:", status.error);
			}
		});
	});

	jQuery(document).on('click', '.cp_mentor_refuse_team, .cp_mentor_accept_team, .cp_team_refuse_mentor, .cp_team_accept_mentor', function(e) {
		e.preventDefault();

		const thisform = jQuery(this).closest('form');
		const team_id = thisform.find('[name="team_id"]').val().trim();
		const mentor_id = thisform.find('[name="mentor_id"]').val().trim();
		const message_id = thisform.find('[name="message_id"]').val().trim();
		const action = jQuery(this).val().trim();
		//const contact_type = thisform.find('[name="contact_type"]').val().trim();
		//const message = thisform.find('[name="message"]').val().trim();

		var formdata = thisform.serialize();

		formdata += '&action=' + action;

		let errors = [];

		if ( ! team_id || ! mentor_id || ! message_id || ! action ) errors.push("A form error has occurred.");

		if (errors.length > 0) {
			jQuery('#ajax-response').html(errors.join("<br>")).addClass('ajax-failure');
			jQuery('#ajax-response').show();
			return;
		}

		jQuery.ajax({
			url: cyberpatriot.ajax_url,
			type: 'POST',
			data: {
				action: 'process_mentor_actions_form',
				nonce: cyberpatriot.nonce,
				data: formdata
			},
			success: function(response) {
				console.log( response );
				jQuery('#ajax-response div.message').html("<b>SUCCESS</b><br/>"+response.message);
				jQuery('#ajax-response').removeClass('ajax-failure');
				jQuery('#ajax-response').addClass('ajax-success');
				jQuery('#ajax-response').show();
			},
			error: function(xhr,status,error) {
				jQuery('#ajax-response div.message').html("<b>PROBLEM</b><br/>There has been an error processing your form.");
				jQuery('#ajax-response').removeClass('ajax-success');
				jQuery('#ajax-response').addClass('ajax-failure');
				jQuery('#ajax-response').show();
				console.error("AJAX Error:", status.error);
			}
		});
	});

