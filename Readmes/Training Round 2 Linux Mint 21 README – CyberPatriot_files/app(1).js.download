	// COMPETITOR FUNCTIONS
	// ===================================================================

	jQuery('.cp_competitor_actions').change(function() {
		$parent_form = jQuery(this).closest('form');
		competitor_id = $parent_form.find('.competitor_id').val();
		if (jQuery(this).val() === 'update_competitor') {
			competitor_update( competitor_id );
		}
		if (jQuery(this).val() === 'delete_competitor') {
			cp_confirm( competitor_id, 'delete_competitor' );
		}
		if (jQuery(this).val() === 'move_competitor') {
			cp_confirm( competitor_id, 'move_competitor' );
		}
		if (jQuery(this).val() === 'resend_competitor') {
			cp_confirm( competitor_id, 'resend_competitor' );
		}
		if (jQuery(this).val() === 'assign_competitor') {
			team_id = jQuery('option:selected', this).data('team_id');
			team_name = jQuery('option:selected', this).text();
			competitor_reassign( competitor_id, team_id, team_name );
		}
		jQuery('.cp_competitor_actions option').prop('selected', function() {
			return this.defaultSelected;
		});
	});

	function competitor_update( competitor_id ) {
		login_id = jQuery('#login_id').val();
		if ( /^-?\d+$/.test(String(login_id)) ) {
			jQuery.ajax({
				url: cyberpatriot.form_url,
				type: 'POST',
				data: {
					form: 'competitor',
					id: competitor_id,
					args: {
						coach_id: login_id,
						title: 'Edit Competitor Info'
					},
				},
				success: function(response) {
					jQuery('#popup-form-container div').html(response); // Load form into the popup container
					jQuery('#popup-form-container').slideDown(); // Show the popup
				},
				error: function(xhr, status, error) {
					console.error("Error loading form:", error);
				}
			});
		} else {
			jQuery('#popup-form-container div').html("Coach ID could not be verified. Please login again."); // Load form into the popup container
			jQuery('#popup-form-container').slideDown(); // Show the popup
		}
	};

	function competitor_reassign( competitor_id, team_id ) {
		jQuery.ajax({
			url: cyberpatriot.form_url,
			type: 'POST',
			data: {
				form: 'competitor_reassign',
				id: competitor_id,
				args: {
					team_id: team_id,
					team_name: team_name
				},
			},
			success: function(response) {
				jQuery('#popup-form-container div').html(response); // Load form into the popup container
				jQuery('#popup-form-container').slideDown(); // Show the popup
			},
			error: function(xhr, status, error) {
				console.error("Error loading form:", error);
			}
		});
	};

