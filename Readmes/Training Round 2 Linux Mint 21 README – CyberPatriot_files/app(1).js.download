	});

	function cp_invoice_form( id, teams ) {
		jQuery.ajax({
			url: cyberpatriot.form_url,
			type: 'POST',
			data: {
				form: 'create_invoice',
				id: id,
				args: {
					teams: teams
				},
			},
			success: function(response) {
				jQuery('.close_button').hide();
				jQuery('#popup-form-container div').html(response); // Load form into the popup container
				jQuery('#popup-form-container').slideDown(); // Show the popup
			},
			error: function(xhr, status, error) {
				console.error("Error loading form:", error);
			}
		});

	}

	jQuery(document).on('click', '.pay-now-button', function(e) {
