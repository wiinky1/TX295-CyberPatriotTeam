	jQuery('.cp_team_actions').change(function() {
		$parent_form = jQuery(this).closest('form');
		team_id = $parent_form.find('.team_id').val();
		if (jQuery(this).val() === 'register_competitor') {
			team_register_competitor( team_id );
		}
		if (jQuery(this).val() === 'edit_cisco') {
			team_edit_cisco( team_id );
		}
		if (jQuery(this).val() === 'find_mentor') {
			console.log(".cp_team_actions - team id is " + team_id);
			team_find_mentor( team_id );
		}
		if (jQuery(this).val() === 'resend_verifier') {
			cp_confirm( team_id, 'resend_verifier' )
		}
		if (jQuery(this).val() === 'request_waiver') {
			cp_confirm( team_id, 'request_waiver' )
		}
		if (jQuery(this).val() === 'pay_now') {
			cp_confirm( team_id, 'pay_now' )
		}
		if (jQuery(this).val() === 'invoice') {}
		if (jQuery(this).val() === 'receipt') {}
		if (jQuery(this).val() === 'edit_team') {
			add_edit_team(team_id);
		}
		if (jQuery(this).val() === 'delete_team') {
			cp_confirm( team_id, 'delete_team' )
		}
		jQuery('.cp_team_actions option').prop('selected', function() {
			return this.defaultSelected;
		});
	});

