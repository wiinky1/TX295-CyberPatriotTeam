			}
		});

	}

	// GENERIC FUNCTIONS
	// ===================================================================

	function cp_confirm( id, action ) {
		form = 'confirm';
		if ( action == 'request_waiver' ) {
			form = 'request_waiver';
		}
		if ( action == 'pay_now' ) {
			form = 'pay_now';
		}
		jQuery.ajax({
			url: cyberpatriot.form_url,
			type: 'POST',
			data: {
				form: form,
				id: id,
				args: {
					action: action
				},
			},
			success: function(response) {
				jQuery('.close_button').hide();
				jQuery('#popup-form-container div').html(response); // Load form into the popup container
				jQuery('#popup-form-container').slideDown(); // Show the popup
			},
			error: function(xhr, status, error) {
				console.error("Error loading form:", error);
			}
		});

	}

	function cp_complete( response ) {

		title = ( response.title ) ? response.title : 'Action Complete';
		message = response.message;

		jQuery(".confirm-form").html('<h2>' + title + '</h2><div id="form-message">' + message + '</div><form id="cp-confirm-form" class="portal-form" method="post"><input type="button" value="Okay" onClick="location.reload();" /></form>')

	}

	function activateTab(tabId) {
		jQuery('.tab-button').each(function () {
			jQuery(this).toggleClass('active', jQuery(this).data('tab') === tabId);
		});

		jQuery('.tab-panel').each(function () {
			jQuery(this).toggleClass('active', jQuery(this).attr('id') === tabId);
		});
	}

	// Click handler
	jQuery('.tab-button, .tab-link').on('click', function () {
		var tabId = jQuery(this).data('tab');

		// Store selection
		localStorage.setItem('activeTab', tabId);

		activateTab(tabId);
	});

	// Restore saved tab on load
	var savedTab = localStorage.getItem('activeTab');

	if (savedTab && jQuery('#' + savedTab).length) {
		activateTab(savedTab);
	}

});

// STRIPE
document.querySelectorAll('.share-button').forEach((shareButton) => {
	shareButton.addEventListener('click', async (event) => {
		event.preventDefault();

		const shareLink = event.currentTarget;

		const shareData = {
			title: shareLink.dataset.shareTitle,
			text: shareLink.dataset.shareText,
			url: shareLink.dataset.shareUrl
		};

		try {
			// Check if the browser supports native sharing
			if (navigator.share) {
				await navigator.share(shareData);
				console.log('Shared successfully');
			} else {
				// Fallback if browser doesn't support Web Share API
				alert('Sharing not supported. URL: ' + shareData.url);
			}
		} catch (err) {
			console.log('Error or user cancelled: ', err);
		}
	});
});
